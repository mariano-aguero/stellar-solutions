{
  "name": "@stellar-solutions/core",
  "version": "0.1.0",
  "description": "Shared utilities, types, and Horizon client for stellar-solutions SDKs",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/mariano-aguero/stellar-solutions" },
  "keywords": ["stellar", "blockchain", "sdk", "core"],
  "type": "module",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --reporter=verbose src/__tests__/integration"
  },
  "peerDependencies": { "@stellar/stellar-sdk": ">=13.0.0" },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
