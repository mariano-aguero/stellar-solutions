{
  "name": "@stellar-solutions/notify",
  "version": "0.1.0",
  "description": "Real-time Stellar account watcher with typed events and auto-reconnect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mariano-aguero/stellar-solutions"
  },
  "keywords": [
    "stellar",
    "events",
    "webhook",
    "notify"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --reporter=verbose src/__tests__/integration"
  },
  "dependencies": {
    "@stellar-solutions/core": "workspace:*"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
