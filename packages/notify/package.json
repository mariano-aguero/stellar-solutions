{
  "name": "@stellar-solutions/notify",
  "version": "0.0.0",
  "description": "Real-time Stellar account watcher with typed events and auto-reconnect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mariano-aguero/stellar-solutions"
  },
  "keywords": ["stellar", "events", "webhook", "notify"],
  "type": "module",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --reporter=verbose src/__tests__/integration"
  },
  "dependencies": {
    "@stellar-solutions/core": "workspace:*"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
